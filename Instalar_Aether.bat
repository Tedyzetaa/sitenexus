@echo off
setlocal EnableExtensions
chcp 65001 >nul
title Instalador Aether
set "SELF=%~f0"
set "SETUP=%TEMP%\aether_setup"
set "PYTHONUTF8=1"
set "PYTHONIOENCODING=utf-8"
set "PYEXE="

if /i "%~1"=="extrair" goto :extrair

echo.
echo  ============================================================
echo    AETHER - instalador do bot de Telegram com IA local
echo  ============================================================
echo.

rem ---- 1. extrai o pacote embutido (instalador + codigo do bot) ----
echo [*] Preparando os arquivos do instalador...
if exist "%SETUP%" rd /s /q "%SETUP%" >nul 2>&1
mkdir "%SETUP%" >nul 2>&1
call :extract_payload "%SETUP%"
if errorlevel 1 goto :erro_pkg
if not exist "%SETUP%\installer.py" goto :erro_pkg

rem ---- 2. Python 3.10 a 3.13 (instala sozinho se nao tiver) ----
call :find_python
if defined PYEXE goto :py_ok
call :install_python
call :find_python
if not defined PYEXE goto :erro_py
:py_ok
echo [OK] Python encontrado: %PYEXE%

rem ---- 3. o resto (venv, bibliotecas, testes, Ollama, modelo, atalho) e feito em Python ----
%PYEXE% "%SETUP%\installer.py" %*
set "RC=%errorlevel%"
if "%RC%"=="0" rd /s /q "%SETUP%" >nul 2>&1
goto :fim

:erro_pkg
echo [X] Nao consegui extrair os arquivos embutidos. O arquivo .bat pode estar corrompido
echo     (ou foi editado em um editor que alterou as quebras de linha). Baixe-o de novo.
set "RC=1"
goto :fim

:erro_py
echo [X] Nao foi possivel instalar o Python automaticamente.
echo     Instale o Python 3.12 em https://www.python.org/downloads/ (marque "Add python.exe to PATH")
echo     e execute este instalador de novo.
set "RC=1"
goto :fim

:fim
echo.
pause
exit /b %RC%

rem ============================================================
rem  Sub-rotinas
rem ============================================================
:extract_payload
set "A_DEST=%~1"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$l=[IO.File]::ReadAllLines($env:SELF); $s=[Array]::IndexOf($l,'#PAYLOAD_BEGIN'); $e=[Array]::IndexOf($l,'#PAYLOAD_END'); if($s -lt 0 -or $e -le $s){exit 2}; $b=[string]::Join('',$l[($s+1)..($e-1)]); $z=Join-Path $env:A_DEST 'payload.zip'; [IO.File]::WriteAllBytes($z,[Convert]::FromBase64String($b)); Expand-Archive -LiteralPath $z -DestinationPath $env:A_DEST -Force"
exit /b %errorlevel%

:find_python
set "PYEXE="
for %%C in ("py -3.12" "py -3.13" "py -3.11" "py -3.10" "python" "python3") do if not defined PYEXE call :try_py %%~C
for %%P in ("%LOCALAPPDATA%\Programs\Python\Python312\python.exe" "%LOCALAPPDATA%\Programs\Python\Python313\python.exe" "%LOCALAPPDATA%\Programs\Python\Python311\python.exe" "%LOCALAPPDATA%\Programs\Python\Python310\python.exe" "%ProgramFiles%\Python312\python.exe" "%ProgramFiles%\Python311\python.exe") do if not defined PYEXE if exist %%P call :try_py %%P
exit /b 0

:try_py
%* -c "import sys,ssl,venv;sys.exit(0 if (3,10)<=sys.version_info[:2]<=(3,13) else 1)" >nul 2>&1
if not errorlevel 1 set PYEXE=%*
exit /b 0

:install_python
echo [*] Python 3.10-3.13 nao encontrado. Instalando o Python 3.12 (somente para o seu usuario, sem pedir administrador)...
set "PYSETUP=%SETUP%\python-setup.exe"
set "PYOK="
for %%U in ("https://www.python.org/ftp/python/3.12.10/python-3.12.10-amd64.exe" "https://www.python.org/ftp/python/3.12.8/python-3.12.8-amd64.exe") do if not defined PYOK call :dl_python %%U
if defined PYOK (
    echo [*] Executando o instalador do Python... aguarde.
    start "" /wait "%PYSETUP%" /quiet InstallAllUsers=0 PrependPath=1 Include_launcher=1 Include_pip=1 Include_test=0 Shortcuts=0
)
call :find_python
if defined PYEXE exit /b 0
where winget >nul 2>&1
if errorlevel 1 exit /b 1
echo [*] Tentando instalar o Python pelo winget...
winget install -e --id Python.Python.3.12 --scope user --silent --accept-package-agreements --accept-source-agreements
call :find_python
exit /b 0

:dl_python
set "A_URL=%~1"
set "A_FILE=%PYSETUP%"
echo [*] Baixando %~1
powershell -NoProfile -ExecutionPolicy Bypass -Command "[Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12; $ProgressPreference='SilentlyContinue'; try { Invoke-WebRequest -Uri $env:A_URL -OutFile $env:A_FILE -UseBasicParsing; $s=Get-AuthenticodeSignature -LiteralPath $env:A_FILE; if($s.Status -eq 'Valid' -and $s.SignerCertificate.Subject -like '*Python Software Foundation*'){exit 0}else{exit 3} } catch { exit 1 }"
if not errorlevel 1 set "PYOK=1"
exit /b 0

:extrair
set "SETUP=%CD%\Aether_instalador_fonte"
mkdir "%SETUP%" >nul 2>&1
call :extract_payload "%SETUP%"
if errorlevel 1 goto :extrair_erro
del "%SETUP%\payload.zip" >nul 2>&1
echo [OK] Codigo-fonte extraido em: %SETUP%
exit /b 0
:extrair_erro
echo [X] Falha ao extrair.
exit /b 1
