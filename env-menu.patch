+# --- Variaveis de ambiente (.env) -------------------------------------------------------
+def _supervised() -> bool:
+    """True se o bot roda sob o launcher (start.sh/start.bat exportam AETHER_SUPERVISED e religam o processo)."""
+    return bool(os.environ.get("AETHER_SUPERVISED"))
+
+
+def _env_resolve(idx_s: str, crc: str) -> tuple[int, envfile.EnvKey] | None:
+    """(indice, chave) se o botao ainda aponta para a mesma chave; None se a lista mudou."""
+    keys = envfile.list_keys()
+    if idx_s.isdigit() and int(idx_s) < len(keys) and _crc(keys[int(idx_s)].name) == crc:
+        return int(idx_s), keys[int(idx_s)]
+    return None
+
+
+def screen_env(deps: h.Deps, page: int = 0, notice: str = "") -> Screen:
+    keys = envfile.list_keys()
+    pages = max(1, -(-len(keys) // ENV_PER_PAGE))
+    page = min(max(page, 0), pages - 1)
+    start = page * ENV_PER_PAGE
+    chunk = keys[start : start + ENV_PER_PAGE]
+    new = sum(1 for k in keys if k.is_new)
+
+    head = f"🔐 <b>Variáveis de ambiente</b> — {len(keys)} chaves"
+    if new:
+        head += f" · 🆕 {new} nova(s)"
+    parts = []
+    if notice:
+        parts.append(notice)
+    if deps.cache.get("env_dirty"):
+        parts.append("⚠️ <b>Alterações pendentes</b> — reinicie o bot para aplicar.")
+    parts.append(head)
+    lines = []
+    for k in chunk:
+        mark = "🆕" if k.is_new else ("🔒" if k.secret else "▫️")
+        val = "<i>(padrão do bot)</i>" if k.is_new else f"<code>{_esc(envfile.mask(k.name, k.value))}</code>"
+        lines.append(f"{mark} <code>{_esc(k.name)}</code> = {val}")
+    parts.append("\n".join(lines) if lines else "<i>Nenhuma variável encontrada.</i>")
+    parts.append("<i>Toque numa chave para ver ou alterar. Segredos aparecem mascarados.</i>")
+
+    buttons = [
+        Btn(_short(f"{'🆕 ' if k.is_new else ''}{k.name}", 30), callback_data=f"a:ev:{start + i}:{_crc(k.name)}")
+        for i, k in enumerate(chunk)
+    ]
+    rows = _chunk(buttons, 2)
+    if pages > 1:
+        rows.append(_pager("a:env", page, pages))
+    tools = [Btn("🔄 Reiniciar bot", callback_data="a:er")]
+    if envfile.has_backup():
+        tools.insert(0, Btn("↩️ Desfazer última", callback_data="a:eu"))
+    rows.append(tools)
+    rows.append([Btn("⬅️ Admin", callback_data="a:home")])
+    return "\n\n".join(parts), Kb(rows)
+
+
+def screen_env_key(deps: h.Deps, idx: int, k: envfile.EnvKey, notice: str = "") -> Screen:
+    lines = []
+    if notice:
+        lines.append(notice + "\n")
+    lines.append(f"🔐 <b>{_esc(k.name)}</b>{' 🔒' if k.secret else ''}")
+    if k.is_new:
+        lines.append("Valor atual: <i>não definida — o bot usa o padrão interno</i>")
+    else:
+        lines.append(f"Valor atual: <code>{_esc(envfile.mask(k.name, k.value))}</code>")
+    show_default = k.default and not k.secret
+    if show_default:
+        lines.append(f"No .env.example: <code>{_esc(k.default)}</code>")
+    if k.help:
+        lines.append(f"\n<i>{_esc(k.help)}</i>")
+    fmt = envfile.hint(k.name)
+    if fmt:
+        lines.append(f"Formato: {_esc(fmt)}")
+    lines.append("\n⚠️ A mudança só vale depois de reiniciar o bot.")
+
+    ref = f"{idx}:{_crc(k.name)}"
+    rows = [[Btn("✏️ Alterar", callback_data=f"a:ee:{ref}")]]
+    extra = []
+    if show_default and k.value != k.default:
+        extra.append(Btn("↩️ Usar o do exemplo", callback_data=f"a:ed:{ref}"))
+    if k.in_env and k.value and k.name not in envfile.REQUIRED:
+        extra.append(Btn("🗑 Limpar", callback_data=f"a:ex:{ref}"))
+    if extra:
+        rows.append(extra)
+    rows.append([Btn("⬅️ Variáveis", callback_data=f"a:env:{idx // ENV_PER_PAGE}")])
+    return "\n".join(lines), Kb(rows)
+
