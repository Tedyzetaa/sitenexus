+async def _verify_token(token: str) -> None:
+    """Confere o token novo no Telegram ANTES de salvar (token errado = bot que nao volta apos reiniciar)."""
+    try:
+        async with httpx.AsyncClient(timeout=10.0) as cli:
+            resp = await cli.get(f"https://api.telegram.org/bot{token}/getMe")
+    except httpx.HTTPError:  # sem log/mensagem do erro: a URL contem o token
+        raise envfile.EnvError("Não consegui falar com o Telegram para validar o token agora. Nada foi salvo.") from None
+    if resp.status_code == 200:
+        return
+    if resp.status_code in (401, 404):
+        raise envfile.EnvError("O Telegram recusou esse token. Nada foi salvo.")
+    raise envfile.EnvError(f"O Telegram respondeu {resp.status_code} ao validar o token. Nada foi salvo.")
+
