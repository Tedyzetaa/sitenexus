+def request_restart(delay: float = 1.5) -> None:
+    """Encerra o processo com RESTART_EXIT_CODE; o start.sh o religa. Idempotente (toque duplo)."""
+    global _restarting
+    if _restarting:
+        return
+    _restarting = True
+    log.warning("Reinicio solicitado pelo painel de administracao.")
+
+    def _go() -> None:
+        logging.shutdown()
+        os._exit(RESTART_EXIT_CODE)
+
+    asyncio.get_running_loop().call_later(delay, _go)
+
